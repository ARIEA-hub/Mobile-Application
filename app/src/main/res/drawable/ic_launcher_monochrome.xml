<?xml version="1.0" encoding="utf-8"?>
<!--
    One-colour alarm clock for Android 13+ themed icons. The system tints it to match the wallpaper, so it
    must be a plain silhouette; the full-colour logo cannot be used here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Clock face: a ring, so the hands inside stay visible once the system tints everything one colour -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:pathData="M54,56m-24,0a24,24 0,1 1,48 0a24,24 0,1 1,-48 0" />
    <!-- Bells -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M28,36a9,9 0,1 1,12.7 -8.2a30,30 0,0 0,-10.5 10.4z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M80,36a9,9 0,1 0,-12.7 -8.2a30,30 0,0 1,10.5 10.4z" />
    <!-- Feet -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,78l-5,7l4,2l6,-7z M72,78l5,7l-4,2l-6,-7z" />
    <!-- Hands -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M54,43v13l9,6" />
</vector>
